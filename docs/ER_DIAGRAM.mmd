erDiagram
    BRANCH ||--o{ EMPLOYEE : "employs"
    BRANCH ||--o{ ACCOUNT : "maintains"
    BRANCH ||--o{ LOAN : "disburses"
    CUSTOMER ||--o{ ACCOUNT_HOLDER : "holds"
    ACCOUNT ||--o{ ACCOUNT_HOLDER : "has_holders"
    CUSTOMER ||--o{ LOAN : "borrows"
    ACCOUNT ||--o{ BANK_TRANSACTION : "records"
    LOAN ||--o{ LOAN_PAYMENT : "repaid_by"

    BRANCH {
        int BranchID PK
        varchar BranchName
        varchar IFSCCode UK
        varchar Address
        varchar City
        varchar State
        varchar ContactNumber
        datetime CreatedAt
    }

    EMPLOYEE {
        int EmployeeID PK
        varchar EmployeeName
        varchar Mobile
        varchar Email UK
        varchar Designation
        decimal Salary
        date JoiningDate
        int BranchID FK
    }

    CUSTOMER {
        int CustomerID PK
        varchar FirstName
        varchar LastName
        date DateOfBirth
        enum Gender
        varchar Mobile UK
        varchar Email UK
        varchar Address
        varchar City
        datetime RegistrationDate
    }

    ACCOUNT {
        int AccountID PK
        varchar AccountNumber UK
        enum AccountType
        datetime OpeningDate
        decimal Balance
        enum Status
        int BranchID FK
    }

    ACCOUNT_HOLDER {
        int CustomerID PK_FK
        int AccountID PK_FK
        datetime HolderSince
        enum HolderType
    }

    BANK_TRANSACTION {
        int TransactionID PK
        int AccountID FK
        enum TransactionType
        decimal Amount
        datetime TransactionDate
        varchar Description
        varchar ReferenceNumber
        enum TransactionStatus
    }

    LOAN {
        int LoanID PK
        int CustomerID FK
        int BranchID FK
        enum LoanType
        decimal LoanAmount
        decimal InterestRate
        date StartDate
        int TenureMonths
        enum LoanStatus
    }

    LOAN_PAYMENT {
        int PaymentID PK
        int LoanID FK
        datetime PaymentDate
        decimal Amount
        enum PaymentMode
        varchar ReferenceNumber UK
    }
