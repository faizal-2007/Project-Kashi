erDiagram
    BRANCH ||--o{ EMPLOYEE : employs
    BRANCH ||--o{ ACCOUNT : hosts
    BRANCH ||--o{ LOAN : processes
    CUSTOMER ||--o{ ACCOUNT_HOLDER : holds
    ACCOUNT ||--o{ ACCOUNT_HOLDER : has
    CUSTOMER ||--o{ LOAN : applies_for
    ACCOUNT ||--o{ BANK_TRANSACTION : records
    LOAN ||--o{ LOAN_PAYMENT : receives

    BRANCH {
        int BranchID PK
        varchar BranchName
        char IFSCCode UK
        varchar Address
        varchar City
        varchar State
        varchar ContactNumber
    }
    CUSTOMER {
        int CustomerID PK
        varchar FirstName
        varchar LastName
        date DateOfBirth
        enum Gender
        varchar Mobile UK
        varchar Email UK
        varchar Address
        varchar City
        datetime RegistrationDate
    }
    EMPLOYEE {
        int EmployeeID PK
        varchar EmployeeName
        varchar Mobile UK
        varchar Email UK
        varchar Designation
        decimal Salary
        date JoiningDate
        int BranchID FK
    }
    ACCOUNT {
        int AccountID PK
        varchar AccountNumber UK
        enum AccountType
        datetime OpeningDate
        decimal Balance
        enum Status
        int BranchID FK
    }
    ACCOUNT_HOLDER {
        int CustomerID PK,FK
        int AccountID PK,FK
        datetime HolderSince
        enum HolderType
    }
    BANK_TRANSACTION {
        bigint TransactionID PK
        int AccountID FK
        enum TransactionType
        decimal Amount
        datetime TransactionDate
        varchar Description
        varchar ReferenceNumber UK
        varchar TransferGroupReference
        enum TransactionStatus
    }
    LOAN {
        int LoanID PK
        int CustomerID FK
        int BranchID FK
        enum LoanType
        decimal LoanAmount
        decimal InterestRate
        date StartDate
        int TenureMonths
        enum LoanStatus
    }
    LOAN_PAYMENT {
        int PaymentID PK
        int LoanID FK
        datetime PaymentDate
        decimal Amount
        enum PaymentMode
        varchar ReferenceNumber UK
    }
